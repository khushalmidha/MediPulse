PORT=8080
NODE_ENV=development
DATABASE_URL=mongodb://127.0.0.1:27017/medipulse
TOKEN_KEY=change-me
CLIENT_URLS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8080
MEDIPULSE_BASE_DOMAIN=medipulse.com

# Hospital system: signs approve/reject email links and receives registration alerts.
HOSPITAL_APPROVAL_SECRET=change-this-hospital-approval-secret
ADMIN_ALERT_EMAIL=admin@example.com

# Review system: signs patient review request links.
REVIEW_SIGNATURE_SECRET=change-this-review-link-secret

# Hospital website / Vercel API.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_METERED_TURN_APP=
VITE_METERED_TURN_API_KEY=
VITE_METERED_TURN_URL=

APPOINTMENT_FEE_INR=199

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM="MediPulse <your-email@example.com>"
RESEND_API_KEY=your-resend-api-key
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-brevo-sender@example.com
BREVO_SENDER_NAME=MediPulse

# Trained disease-prediction model (medipulse-disease-prediction service).
# Triage uses this as the primary predictor; Gemini is only the fallback.
DISEASE_PREDICTION_SERVICE_URL=http://127.0.0.1:8000/predict
# Predictions below this confidence are ignored in favour of the Gemini fallback.
ML_CONFIDENCE_THRESHOLD=0.3

REDIS_URL=redis://127.0.0.1:6379
AUTO_REFUND_WORKER_INTERVAL_MS=60000

# Appointment booking
# The amount charged at booking is always the doctor's own `consultationFee`.
# This value is only a refund fallback for legacy appointments that stored no payment amount.
APPOINTMENT_BOOKING_FEE_INR=500
# Default fee applied to doctors who have not set their own fee yet.
DEFAULT_CONSULTATION_FEE_INR=500
MAX_CONSULTATION_FEE_INR=100000
# Starting wallet balance credited to new patient accounts (demo virtual gateway).
INITIAL_USER_WALLET_BALANCE=5000

# Enforce the booking OTP step (send OTP -> verify -> book with bookingToken).
# Currently "false" because the booking UI does not collect the OTP yet; turn this on
# after the frontend starts sending bookingToken, otherwise every booking returns 401.
REQUIRE_BOOKING_OTP=false


ADMIN_USER_IDS=
VPAY_RATE_LIMIT_MAX=30
VPAY_RATE_LIMIT_WINDOW_SEC=60

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=medipulse-api
KAFKA_APPOINTMENT_TOPIC=medipulse.appointments
KAFKA_VPAY_CONSUMER_GROUP=medipulse-vpay-consumers
KAFKA_PAYMENTS_CREATED_TOPIC=payments.created
KAFKA_PAYMENTS_COMPLETED_TOPIC=payments.completed
KAFKA_PAYMENTS_FAILED_TOPIC=payments.failed
KAFKA_REFUNDS_CREATED_TOPIC=refunds.created
KAFKA_REFUNDS_COMPLETED_TOPIC=refunds.completed
KAFKA_WALLET_UPDATED_TOPIC=wallet.updated
KAFKA_NOTIFICATIONS_CREATED_TOPIC=notifications.created
KAFKA_ANALYTICS_EVENTS_TOPIC=analytics.events
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain
