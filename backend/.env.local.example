NODE_ENV=development
DATABASE_URL=mongodb://127.0.0.1:27017/medipulse_dev?replicaSet=rs0&directConnection=true
TOKEN_KEY=local-development-signing-key-replace-before-production
USE_REAL_REDIS=true
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_BROKERS=localhost:9092
KAFKA_CREATE_TOPICS=true
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
MAIL_DELIVERY=disabled
REQUIRE_BOOKING_OTP=false
FRONTEND_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
TEST_DATABASE_URL=mongodb://127.0.0.1:27017/medipulse_test?replicaSet=rs0&directConnection=true
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# P06: manual consultation completion by default; optional online deadline (0..480 minutes).
CONSULTATION_DURATION_MINUTES=0
# Current supported realtime deployment is one API process.
API_INSTANCES=1
# Optional coturn REST credentials; shared secret stays on the backend.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600
STUN_URLS=stun:stun.l.google.com:19302

# Explicit product host configuration; keep preview aliases exact.
PUBLIC_BASE_DOMAIN=medipulse.live
PUBLIC_APP_DOMAINS=
# Optional Vercel team scope; credentials remain server-only.
VERCEL_TEAM_ID=
