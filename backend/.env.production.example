NODE_ENV=production
# Fill these privately; this template is never a deployable credentials file.
DATABASE_URL=
TOKEN_KEY=
CLIENT_URLS=https://medipulse.live
PUBLIC_API_URL=/backend
MAIL_DELIVERY=enabled
# Configure your mail provider privately before relying on real notifications.
REQUIRE_BOOKING_OTP=false

# Browser API: /backend uses the same-origin Nginx relay. An explicit HTTPS API URL is also supported.
# PUBLIC_API_URL=/backend
# CLIENT_URLS must list every approved frontend origin exactly; wildcard/hosted-preview suffixes are refused.

# P06: manual consultation completion by default; optional online deadline (0..480 minutes).
CONSULTATION_DURATION_MINUTES=0
# Current supported realtime deployment is one API process.
API_INSTANCES=1
# Optional coturn REST credentials; shared secret stays on the backend.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600
STUN_URLS=stun:stun.l.google.com:19302

# Explicit product host configuration; keep preview aliases exact.
PUBLIC_BASE_DOMAIN=medipulse.live
PUBLIC_APP_DOMAINS=
# Optional Vercel team scope; credentials remain server-only.
VERCEL_TEAM_ID=
