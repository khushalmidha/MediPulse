{
    email {$TLS_EMAIL}
    admin off
}

{$API_HOST} {
    request_body {
        max_size 210MB
    }
    # CloudFront forwards /backend unchanged; also serve direct API URLs.
    handle_path /backend/* {
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 180s
            }
        }
    }
    handle {
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 180s
            }
        }
    }
    # Caddy handles HTTPS/renewal and websocket upgrades automatically.
    # No public file server: every HLS segment/JPEG passes existing backend auth.
}
