[Unit]
Description=MediPulse AWS pilot (EBS required)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/medipulse

[Service]
Type=simple
WorkingDirectory=/opt/medipulse/deploy/aws
EnvironmentFile=/etc/medipulse/runtime.env
ExecStartPre=/usr/bin/mountpoint -q /srv/medipulse
ExecStart=/usr/bin/docker compose -f compose.yml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f compose.yml stop --timeout 30
Restart=always
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
