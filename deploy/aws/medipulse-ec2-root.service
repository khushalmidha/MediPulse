[Unit]
Description=MediPulse EC2 candidate (persistent root EBS)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/medipulse

[Service]
Type=simple
WorkingDirectory=/opt/medipulse/deploy/aws
EnvironmentFile=/etc/medipulse/runtime.env
# Operator creates this marker after validating the approved root volume,
# persistence/termination settings and ownership of the existing directories.
ExecStartPre=/usr/bin/test -f /srv/medipulse/.ec2-root-storage-approved
ExecStartPre=/usr/bin/test -d /srv/medipulse/reels
ExecStartPre=/usr/bin/test -d /srv/medipulse/models
ExecStartPre=/usr/bin/test -d /srv/medipulse/redis
ExecStartPre=/usr/bin/test -d /srv/medipulse/caddy
ExecStart=/usr/bin/docker compose -f compose.yml -f ec2-root.override.yml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f compose.yml -f ec2-root.override.yml stop --timeout 30
Restart=always
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
