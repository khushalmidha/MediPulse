# Copy privately to /etc/medipulse/backend.env, chmod 600; never commit filled values.
# STAGING: separate isolated Mongo DB/credentials, MAIL_DELIVERY=disabled.
# PRODUCTION: retain existing approved Atlas DB; no data migration by this template.
DATABASE_URL=
TOKEN_KEY=
CLIENT_URLS=https://medipulse.live,https://www.medipulse.live
FRONTEND_URL=https://medipulse.live
PUBLIC_BACKEND_URL=https://api.medipulse.live
PUBLIC_BASE_DOMAIN=medipulse.live
PUBLIC_APP_DOMAINS=medipulse.live,www.medipulse.live
GOOGLE_CLIENT_ID=
MAIL_DELIVERY=disabled
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MediPulse
MAIL_FROM=
GEMINI_API_KEY=
GEMINI_SMART_BOOKING_MODEL=gemini-3.5-flash-lite
HF_TOKEN=
APPOINTMENT_BOOKING_FEE_INR=500
MAX_CONSULTATION_FEE_INR=100000
INITIAL_USER_WALLET_BALANCE=5000
REQUIRE_BOOKING_OTP=false
CONSULTATION_DURATION_MINUTES=0
REELS_MAX_UPLOAD_BYTES=209715200
REELS_MAX_OUTPUT_BYTES=536870912
REELS_PROCESS_TIMEOUT_MS=180000
REELS_REVIEWER_DOCTOR_IDS=
# Optional coturn compatible REST-auth secret; never expose in VITE variables.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600
STUN_URLS=stun:stun.l.google.com:19302
# Preserve other existing approval/review signing keys and provider configuration privately.
# API_INSTANCES/REDIS/feature flags/binary paths are intentionally enforced by compose.
