{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeNetworkAcls"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/DeploymentId": "medipulse-staging-20261113",
          "ec2:InstanceType": "t4g.small",
          "ec2:MetadataHttpTokens": "required",
          "ec2:Tenancy": "default",
          "aws:RequestTag/DataClass": "synthetic-only"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/DeploymentId": "medipulse-staging-20261113",
          "ec2:VolumeType": "gp3",
          "aws:RequestTag/DataClass": "synthetic-only"
        },
        "NumericEquals": {
          "ec2:VolumeSize": "30",
          "ec2:VolumeIops": "3000",
          "ec2:VolumeThroughput": "125"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1::image/ami-09a93d801db0bafae",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:subnet/*",
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:network-interface/*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DeploymentId": "medipulse-staging-20261113",
          "aws:ResourceTag/DataClass": "synthetic-only"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/DeploymentId": "medipulse-staging-20261113",
          "aws:RequestTag/DataClass": "synthetic-only"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:vpc/*",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:instance/*",
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:volume/*",
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:network-interface/*",
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:security-group/*",
        "arn:aws:ec2:us-east-1::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateSecurityGroup",
            "CreateSnapshot",
            "CreateVolume"
          ],
          "aws:RequestTag/DeploymentId": "medipulse-staging-20261113",
          "aws:RequestTag/DataClass": "synthetic-only"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:GetConsoleOutput",
        "ec2:DeleteVolume"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:security-group/*",
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:instance/*",
        "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DeploymentId": "medipulse-staging-20261113",
          "aws:ResourceTag/DataClass": "synthetic-only"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-19T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DeploymentId": "medipulse-staging-20261113",
          "aws:ResourceTag/DataClass": "synthetic-only",
          "aws:ResourceTag/Role": "staging-root"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-19T00:00:00Z"
        },
        "NumericEquals": {
          "ec2:VolumeSize": "30"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:us-east-1::snapshot/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/DeploymentId": "medipulse-staging-20261113",
          "aws:RequestTag/DataClass": "synthetic-only",
          "aws:RequestTag/Role": "synthetic-backup"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume",
        "ec2:DeleteSnapshot"
      ],
      "Resource": "arn:aws:ec2:us-east-1::snapshot/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DeploymentId": "medipulse-staging-20261113",
          "aws:ResourceTag/DataClass": "synthetic-only",
          "aws:ResourceTag/Role": "synthetic-backup"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-19T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/DeploymentId": "medipulse-staging-20261113",
          "aws:RequestTag/DataClass": "synthetic-only",
          "aws:RequestTag/Role": "restore",
          "ec2:VolumeType": "gp3"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        },
        "NumericEquals": {
          "ec2:VolumeSize": "30",
          "ec2:VolumeIops": "3000",
          "ec2:VolumeThroughput": "125"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "Null": {
          "ec2:ParentSnapshot": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DeploymentId": "medipulse-staging-20261113",
          "aws:ResourceTag/DataClass": "synthetic-only",
          "aws:ResourceTag/Role": "restore"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-19T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DeploymentId": "medipulse-staging-20261113",
          "aws:ResourceTag/DataClass": "synthetic-only"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-19T00:00:00Z"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-1:__ACCOUNT_ID__:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/DeploymentId": "medipulse-staging-20261113",
          "ssm:resourceTag/DataClass": "synthetic-only"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-17T00:00:00Z"
        }
      }
    }
  ]
}
