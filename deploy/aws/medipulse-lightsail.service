# Install ONLY on a separately approved Lightsail staging host after preflight.
[Unit]
Description=MediPulse Lightsail pilot (included persistent SSD)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/medipulse

[Service]
Type=simple
WorkingDirectory=/opt/medipulse/deploy/aws
EnvironmentFile=/etc/medipulse/runtime.env
# Owner creates this marker only after verifying included-disk paths/permissions.
# Unlike the EC2 reference unit, no separate paid EBS mount is required.
ExecStartPre=/usr/bin/test -f /srv/medipulse/.lightsail-storage-approved
ExecStartPre=/usr/bin/test -d /srv/medipulse/reels
ExecStartPre=/usr/bin/test -d /srv/medipulse/models
ExecStartPre=/usr/bin/test -d /srv/medipulse/redis
ExecStartPre=/usr/bin/test -d /srv/medipulse/caddy
ExecStart=/usr/bin/docker compose -f compose.yml -f lightsail.override.yml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f compose.yml -f lightsail.override.yml stop --timeout 30
Restart=always
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
