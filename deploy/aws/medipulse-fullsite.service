[Unit]
Description=MediPulse frontend and API on persistent EC2 root EBS
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/medipulse

[Service]
Type=simple
WorkingDirectory=/opt/medipulse/deploy/aws
EnvironmentFile=/etc/medipulse/runtime.env
ExecStartPre=/usr/bin/test -f /srv/medipulse/.ec2-root-storage-approved
ExecStartPre=/usr/bin/test -s /srv/medipulse/frontend/index.html
ExecStartPre=/usr/bin/test -f /etc/medipulse/backend.env
ExecStart=/usr/bin/docker compose -f compose.yml -f ec2-root.override.yml -f fullsite.override.yml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f compose.yml -f ec2-root.override.yml -f fullsite.override.yml stop --timeout 30
Restart=always
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
